{
	"name": "@twin.org/verifiable-storage-connector-iota",
	"version": "0.9.0",
	"description": "IOTA connector that anchors verifiable storage operations on-chain and returns receipts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-verifiable-storage.git",
		"directory": "packages/verifiable-storage-connector-iota"
	},
	"author": "cornel.filip@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage src/schemas",
		"contracts:build:testnet": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smartContractDeployments/smart-contract-deployments.json --load-env configs/testnet.env",
		"contracts:build:devnet": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smartContractDeployments/smart-contract-deployments.json --load-env configs/devnet.env",
		"contracts:build:mainnet": "move-to-json build \"src/contracts/**/*.move\" --output src/contracts/smartContractDeployments/smart-contract-deployments.json --load-env configs/mainnet.env",
		"contracts:deploy:testnet": "move-to-json deploy --load-env configs/testnet.env --contracts src/contracts/smartContractDeployments/smart-contract-deployments.json",
		"contracts:deploy:devnet": "move-to-json deploy --load-env configs/devnet.env --contracts src/contracts/smartContractDeployments/smart-contract-deployments.json",
		"contracts:deploy:mainnet": "move-to-json deploy --load-env configs/mainnet.env --contracts src/contracts/smartContractDeployments/smart-contract-deployments.json",
		"build:schema": "ts-to-schema ./ts-to-schema.json ./src/schemas",
		"build:jsonld-context": "ts-to-jsonld-context ./ts-to-jsonld-context.json ./src/schemas/types.jsonld",
		"build:compile": "tspc",
		"build": "npm run build:schema && npm run build:jsonld-context && npm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/core": "^0.9.0",
		"@twin.org/crypto": "^0.9.0",
		"@twin.org/data-core": "^0.9.0",
		"@twin.org/data-json-ld": "^0.9.0",
		"@twin.org/dlt-iota": "^0.9.0",
		"@twin.org/verifiable-storage-models": "^0.9.0",
		"@twin.org/logging-models": "^0.9.0",
		"@twin.org/nameof": "^0.9.0",
		"@twin.org/vault-models": "^0.9.0"
	},
	"devDependencies": {
		"@twin.org/entity": "^0.9.0",
		"@twin.org/entity-storage-connector-memory": "^0.9.0",
		"@twin.org/nameof-transformer": "^0.9.0",
		"@twin.org/nameof-vitest-plugin": "^0.9.0",
		"@twin.org/validate-locales": "^0.9.0",
		"@twin.org/move-to-json": "^0.9.0",
		"@twin.org/ts-to-jsonld-context": "^0.9.0",
		"@twin.org/ts-to-schema": "^0.9.0",
		"@twin.org/vault-connector-entity-storage": "^0.9.0",
		"@types/node": "26.0.0",
		"@vitest/coverage-v8": "4.1.9",
		"copyfiles": "2.4.1",
		"dotenv": "17.4.2",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"nodemon": "3.1.14",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.9"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"verifiable-storage",
		"verifiable",
		"storage",
		"proof",
		"immutable",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-verifiable-storage/issues"
	},
	"homepage": "https://twindev.org"
}
