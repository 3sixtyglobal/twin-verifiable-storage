{
	"name": "@twin.org/verifiable-storage-connector-entity-storage",
	"version": "0.0.2-next.5",
	"description": "Implementation of the Verifiable Storage connector using entity storage",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/verifiable-storage.git",
		"directory": "packages/verifiable-storage-connector-entity-storage"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage docs/reference src/schemas",
		"build:schema": "ts-to-schema ./ts-to-schema.json ./src/schemas",
		"build:compile": "tspc",
		"build": "npm run build:schema && npm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build && npm run bundle:esm\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"bundle:esm": "rollup --config rollup.config.mjs --environment MODULE:esm",
		"bundle:cjs": "rollup --config rollup.config.mjs --environment MODULE:cjs",
		"bundle": "npm run bundle:esm && npm run bundle:cjs",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test && npm run bundle && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run bundle && npm run docs"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/data-core": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/verifiable-storage-models": "0.0.2-next.5"
	},
	"devDependencies": {
		"@rollup/plugin-json": "6.1.0",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/ts-to-schema": "next",
		"@vitest/coverage-v8": "3.2.4",
		"@types/node": "24.7.0",
		"copyfiles": "2.4.1",
		"dotenv": "17.2.3",
		"nodemon": "3.1.10",
		"rimraf": "6.0.1",
		"rollup": "4.52.4",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.13",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.cjs",
			"import": "./dist/esm/index.mjs"
		}
	},
	"files": [
		"dist/cjs",
		"dist/esm",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"verifiable-storage",
		"verifiable",
		"storage",
		"proof",
		"immutable",
		"entity",
		"persistence",
		"database",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/verifiable-storage/issues"
	},
	"homepage": "https://twindev.org"
}
