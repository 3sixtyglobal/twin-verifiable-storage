{
	"name": "@twin.org/verifiable-storage-connector-entity-storage",
	"version": "0.0.3-next.13",
	"description": "Entity storage connector that persists verifiable items with allow list controls",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-verifiable-storage.git",
		"directory": "packages/verifiable-storage-connector-entity-storage"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage src/schemas",
		"build:schema": "ts-to-schema ./ts-to-schema.json ./src/schemas",
		"build:jsonld-context": "ts-to-jsonld-context ./ts-to-jsonld-context.json ./src/schemas/types.jsonld",
		"build:compile": "tspc",
		"build": "npm run build:schema && npm run build:jsonld-context && npm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/data-core": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/verifiable-storage-models": "0.0.3-next.13"
	},
	"devDependencies": {
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/ts-to-jsonld-context": "next",
		"@twin.org/ts-to-schema": "next",
		"@vitest/coverage-v8": "4.1.6",
		"@types/node": "25.9.1",
		"copyfiles": "2.4.1",
		"dotenv": "17.4.2",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.11.0",
		"typescript": "6.0.3",
		"vitest": "4.1.6"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"verifiable-storage",
		"verifiable",
		"storage",
		"proof",
		"immutable",
		"entity",
		"persistence",
		"database",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-verifiable-storage/issues"
	},
	"homepage": "https://twindev.org"
}
